# Local development: leave this as-is. Vite proxies /api to the local backend,
# so phones on the same Wi‑Fi can log in via http://<your-pc-ip>:5173
VITE_API_URL="http://127.0.0.1:8000/api/v1"

# Production (Netlify / Vercel build): set this to your LIVE backend, e.g.
# VITE_API_URL="https://komban-lms-backend.onrender.com/api/v1"
# Never use localhost / 127.0.0.1 for production builds.

# Razorpay — replace with KOMBAN payment credentials
VITE_RAZORPAY_KEY_ID="your_razorpay_key_id"
VITE_RAZORPAY_PAYLINK_URL="https://razorpay.me/your_komban_paylink"

# Display conversion for non-India visitors (admin prices stay INR; Razorpay still charges INR)
# Default ≈ ₹83 = $1
VITE_INR_TO_USD_RATE=0.012
